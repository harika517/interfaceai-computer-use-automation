  "private": true,
  "type": "module",
  "description": "Computer-use automation system: LLM discovery, recorded workflows, deterministic replay, human handoff.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bank": "tsx mock-bank/src/server.ts",
