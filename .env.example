# Copy to .env and adjust. These are fake demo values only; never commit .env.
PORT=4000
MOCK_BANK_USERNAME=teller01
MOCK_BANK_PASSWORD=change-me-demo-only
SESSION_SECRET=replace-with-a-long-random-string

# Module 1b controlled failure settings (read at startup only; leave empty for normal behavior)
# Session ends this many seconds after login (E-7). 0 or empty = never.
BANK_SESSION_TTL_SECONDS=
# Delay member search results and account details by this many milliseconds (E-8).
BANK_SLOW_MS=
# Return a server error for: off | search | accounts | all (E-9).
BANK_SERVER_ERROR=off
# Show the System Notice popup on the Member Details page: on | off (E-10).
BANK_NOTICE=off

# --- Module 2: discovery (automation client) ---
# Approved origin for the automation (only this site may be operated).
BANK_URL=http://localhost:4000
# The automation's own login (separate from the bank's settings above; values may match).
BANK_LOGIN_USERNAME=teller01
BANK_LOGIN_PASSWORD=change-me-demo-only
# LLM (provider kept swappable; only openai for now).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini-2026-03-17
OPEN_AI_KEY=
# Optional: none | minimal | low | medium | high. Empty = model default.
LLM_REASONING_EFFORT=
# USD per million tokens, used for the cost estimate in each run.
LLM_PRICE_INPUT_PER_MTOK=0.75
LLM_PRICE_OUTPUT_PER_MTOK=4.50
# Stopping limits (demo defaults).
DISCOVERY_MAX_STEPS=10
DISCOVERY_MAX_SECONDS=120
DISCOVERY_MAX_FAILURES=2
DISCOVERY_MAX_LLM_CALLS=10
# Send a screenshot to the LLM with each page view: on | off.
# Text boxes, protected values and input values are painted over.
DISCOVERY_SCREENSHOTS=off
# Save failure.png on a failed run (protected values, amounts and IDs painted over): on | off.
DISCOVERY_SAVE_FAILURE_SCREENSHOT=off
# Show the browser window (off) or run hidden (on).
BROWSER_HEADLESS=off
# Clicks matching these are risky and stop the run with NEEDS_HUMAN.
SAFETY_RISKY_KEYWORDS=Edit Profile,Transfer,Delete,Close Account,Update
# Values shown next to these labels are hidden from the LLM and logs.
SAFETY_SENSITIVE_LABELS=Member Name

# --- Module 4: replay (no LLM; uses BANK_URL and BANK_LOGIN_* above) ---
# Longest time one replay may take, in seconds.
REPLAY_MAX_SECONDS=60
# Save failure.png on a failed replay (protected values, amounts and IDs painted over): on | off.
REPLAY_SAVE_FAILURE_SCREENSHOT=off
REPLAY_RUNS_DIR=runs

# --- Module 5: human handoff (with --handoff on discover or replay; needs BROWSER_HEADLESS=off) ---
# How long a person may keep control before the run stops (seconds, 10-3600).
HANDOFF_TIMEOUT_SECONDS=600
# Most handoffs in one run (1-5).
HANDOFF_MAX=2
